PORT=3000
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
# Optional local-only external credentials file; hosting providers should set MONGODB_URI directly.
MONGODB_CREDENTIALS_FILE=C:\Users\user\Downloads\atlas-credentials.env
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
ADMIN_EMAIL=admin-login-email@example.com
ADMIN_PASSWORD=use-a-long-admin-password
SESSION_SECRET=generate-a-long-random-value-at-least-32-characters
APP_URL=https://your-app.vercel.app
